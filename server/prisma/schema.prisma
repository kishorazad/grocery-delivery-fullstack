generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}


model User {
  id        String    @id @default(uuid())

  name      String
  email     String    @unique
  password  String

  role      String    @default("USER")

  phone     String?   @default("")
  avatar    String?   @default("")

  fcmToken String?

  addresses Address[]
  orders    Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  address   String

  city      String
  state     String
  zip       String

  isDefault Boolean  @default(false)

  lat       Float
  lng       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())

  name        String
  slug        String    @unique

  image       String?

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
    id                    String   @id @default(uuid())

    name                  String
    slug                  String   @unique

    description           String?  @default("")
    composition           String?  @default("")
    medicineType          String?  @default("")
    manufacturer          String?  @default("")
    primaryUse            String?  @default("")

    shortDescription      String?  @default("")

    price                 Float
    originalPrice         Float?   @default(0)

    mrp                   Float?   @default(0)
    discountPercent       Int?     @default(0)

    image                 String
    imageUrl              String?  @default("")
    imageUrls             String[]

    category              String

    categoryId            String?
    categoryRelation      Category? @relation(fields: [categoryId], references: [id])

    prescriptionRequired  Boolean? @default(false)

    stock                 Int?     @default(0)

    rating                Float?   @default(0)
    reviewCount           Int?     @default(0)

    productForm           String?  @default("")
    packaging             String?  @default("")
    packageInfo           String?  @default("")

    introduction          String?  @default("")
    benefits              String?  @default("")
    useOf                 String?  @default("")

    safetyAdvice          String?  @default("")
    sideEffects           String?  @default("")
    howToUse              String?  @default("")
    storage               String?  @default("")
    howItWorks            String?  @default("")

    interaction           String?  @default("")
    alcoholInteraction    String?  @default("")
    pregnancyInteraction  String?  @default("")
    lactationInteraction  String?  @default("")
    drivingInteraction    String?  @default("")
    kidneyInteraction     String?  @default("")
    liverInteraction      String?  @default("")

    factBox               String?  @default("")
    qna                   String?  @default("")
    faq                   String?  @default("")

    substitutes           String?  @default("")
    warnings              String?  @default("")
    quickTips             String?  @default("")

    manufacturerDetails   String?  @default("")
    marketerDetails       String?  @default("")
    manufacturerAddress   String?  @default("")

    reference             String?  @default("")
    countryOfOrigin       String?  @default("")
    expiration            String?  @default("")

    dosage                String?  @default("")
    marketer              String?  @default("")

    ifMiss                String?  @default("")

    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
}

model Order {
  id              String @id @default(uuid())

  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items           Json

  shippingAddress Json

  paymentMethod   String @default("card")

  subtotal        Float
  deliveryFee     Float? @default(0)
  tax             Float? @default(0)

  total           Float

  status          String @default("PLACED")

  

  statusHistory   Json

  deliveryPartnerId String?

  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  deliveryOtp     String? @default("")
  trackingNumber     String?
estimatedDelivery  DateTime?

  liveLocation    Json?

  isPaid          Boolean? @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model DeliveryPartner {
  id          String   @id @default(uuid())

  name        String

  email       String   @unique

  password    String

  phone       String

  avatar      String?  @default("")


  vehicleType String?  @default("bike")

  isActive    Boolean? @default(true)

  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}